# Required. Neon Postgres connection string.
# Get it from the Neon console, then paste here or into the create CLI / Vercel env form.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Auto-generated by `bun create then-ecommerce` or `bun setup`.
# For the Vercel Deploy Button, generate with `npx auth@latest secret` and paste.
# Never commit the real value.
BETTER_AUTH_SECRET=

# Public app origin. Local default below.
# After the first Vercel deploy, set this to your public URL (needed for webhooks and auth).
APP_URL=http://localhost:3000

# Mayar environment: sandbox (test payments, recommended first) or production (live money).
# Choose the environment before pasting the matching API key.
MAYAR_ENVIRONMENT=sandbox

# Mayar API key for the environment above (sandbox key and production key differ).
MAYAR_API_KEY=

# UploadThing token for admin product image uploads.
UPLOADTHING_TOKEN=

# Flat shipping amount in IDR, applied once per order.
SHIPPING_FLAT_RATE=0
