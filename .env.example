# Required database connection from Neon.
DATABASE_URL=postgresql://user:password@host/neondb?sslmode=require

# Generated by `bun setup`; never commit the real value.
BETTER_AUTH_SECRET=

# Used to build secure order links and register the Mayar webhook.
APP_URL=http://localhost:3000

# Mayar uses sandbox by default. Set production only after a deliberate switch.
MAYAR_ENVIRONMENT=sandbox
MAYAR_API_KEY=

# UploadThing is used for admin product images.
UPLOADTHING_TOKEN=

# IDR, applied once per order.
SHIPPING_FLAT_RATE=0
