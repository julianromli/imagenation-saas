# Secrets for this Worker.
#
# The Deploy to Cloudflare button reads this file and asks for each value, using
# the comment above it as the explanation. D1, R2, and the rate limiters are
# provisioned automatically from wrangler.jsonc and need nothing here.
#
# For local development, `bun run setup` writes the same keys into .dev.vars.

# Signs session cookies. Generate with: openssl rand -base64 32
# Keep it stable: changing it signs every existing session out.
BETTER_AUTH_SECRET=

# Unlocks the one-time /setup page, which creates your first administrator.
# Choose any long random string. Generate with: openssl rand -base64 24
SETUP_TOKEN=

# Mayar API key. Sandbox and production keys are different values.
# Get it from the Mayar dashboard.
MAYAR_API_KEY=

# BETTER_AUTH_URL is deliberately absent. It is optional, and the deploy button
# asks for every key listed here, so listing it made the form demand a value
# nobody can know before the deploy finishes. Set it as a secret afterwards.
# See "After the first deploy" in README.md.
