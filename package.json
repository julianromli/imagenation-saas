    "dev": "vite dev --port 3000",
    "fix": "ultracite fix",
    "format": "biome format --write .",
    "lint": "ultracite check",
    "preview": "vite preview",
    "setup": "tsx scripts/setup.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
